{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "bun"
    ]
  },
  "include": [
    "*.ts",
    "../src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "../node_modules"
  ]
}
