{
  "name": "hhk-cap01-workspace",
  "private": true,
  "version": "0.2.0",
  "description": "Flutter-first HHK repository with a Node-only Prisma license backend workspace",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "backend-prisma"
  ],
  "scripts": {
    "backend:typecheck": "npm --workspace backend-prisma run typecheck",
    "backend:test": "npm --workspace backend-prisma run test",
    "backend:build": "npm --workspace backend-prisma run build"
  },
  "devDependencies": {
    "@prisma/composer": "0.38.0",
    "@prisma/composer-prisma-cloud": "0.38.0",
    "alchemy": "2.0.0-beta.84",
    "prisma": "8.0.0-rc.33"
  },
  "type": "module"
}
